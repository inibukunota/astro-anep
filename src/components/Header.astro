---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
---
<header>
	<div class="masthead">
		<div class="masthead-top">
			<div>
				<a class="brand" href="/">{SITE_TITLE}</a>
				<p class="tagline">{SITE_TAGLINE}</p>
			</div>
			<nav aria-label="Primary navigation">
				<HeaderLink href="/blog">Blog</HeaderLink>
				<HeaderLink href="/about">About</HeaderLink>
			</nav>
		</div>
		<div class="rule"></div>
	</div>
</header>
<style>
header { padding: 1rem 1rem 0; background: var(--background); }
.masthead { width: min(100%, var(--site-width)); margin: 0 auto; }
.masthead-top {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 1rem;
}
.brand {
	display: block;
	color: var(--text);
	font-family: var(--serif);
	font-size: clamp(2.8rem, 7vw, 5rem);
	font-weight: 700;
	line-height: .9;
	letter-spacing: -.045em;
	text-decoration: none;
}
.tagline {
	margin: .35rem 0 0;
	color: var(--muted);
	font-family: var(--sans);
	font-size: .62rem;
	font-weight: 700;
	letter-spacing: .16em;
	line-height: 1.2;
}
nav {
	display: flex;
	gap: 1.25rem;
	padding-bottom: .2rem;
	font-size: .9rem;
}
nav a { color: var(--text); text-decoration: none; }
nav a.active {
	text-decoration: underline;
	text-underline-offset: .25em;
}
.rule { margin-top: 1rem; border-top: 1px solid var(--text); }

@media (max-width: 600px) {
	header { padding-top: 1rem; }
	.masthead-top {
		align-items: flex-start;
		flex-direction: column;
		gap: 1rem;
	}
	nav { padding-bottom: 0; }
	.brand { font-size: clamp(2.8rem, 15vw, 4rem); }
}
</style>
