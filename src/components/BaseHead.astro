---
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  datePublished?: Date;
  dateModified?: Date;
}
const {
  title,
  description,
  image = '/blog-placeholder-1.jpg',
  type = 'website',
  noIndex = false,
  datePublished,
  dateModified,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.url);
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
<meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title>

<meta property="og:locale" content="en_MY" />
<meta property="og:site_name" content="Hanif Azrai" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{type === 'article' && datePublished && <meta property="article:published_time" content={datePublished.toISOString()} />}
{type === 'article' && dateModified && <meta property="article:modified_time" content={dateModified.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
