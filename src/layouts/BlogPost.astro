---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import FormattedDate from '../components/FormattedDate.astro';
type Props = CollectionEntry<'blog'>['data'];
const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---
<html lang="en">
<head>
	<BaseHead title={title} description={description} image={heroImage} type="article" />
	<StructuredData type="article" title={title} description={description} url={Astro.url} image={heroImage} datePublished={pubDate} dateModified={updatedDate} />
</head>
<body>
	<Header />
	<main>
		<article class="article">
			<header class="article-header">
				<p class="date"><FormattedDate date={pubDate} />{updatedDate && <> · Updated <FormattedDate date={updatedDate} /></>}</p>
				<h1>{title}</h1>
				<p class="description">{description}</p>
			</header>
			{heroImage && <img class="hero-image" width={1020} height={510} src={heroImage} alt="" />}
			<div class="prose"><slot /></div>
		</article>
	</main>
	<Footer />
</body>
</html>
<style>
.article { max-width: var(--reading-width); margin: 0 auto; }
.article-header { margin-bottom: 3rem; }
.date { margin-bottom: 1rem; color: rgb(var(--gray)); font-size: .9rem; }
.article-header h1 { font-size: clamp(2.25rem, 6vw, 4rem); }
.description { margin-top: 1rem; font-size: 1.15rem; color: rgb(var(--gray)); }
.hero-image { width: 100%; margin-bottom: 3rem; }
.prose { color: rgb(var(--gray-dark)); }
@media (max-width: 600px) { .article-header { margin-bottom: 2rem; } .hero-image { margin-bottom: 2rem; } }
</style>
