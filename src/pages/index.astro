---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const items = posts.map((post) => ({
	title: post.data.title,
	url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
	description: post.data.description,
}));
---
<!doctype html>
<html lang="en">
<head>
	<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	<StructuredData type="website" title={SITE_TITLE} description={SITE_DESCRIPTION} url={Astro.url} />
</head>
<body>
	<Header />
	<main>
		<section aria-labelledby="latest-title">
			<div class="section-heading">
				<h1 id="latest-title">Latest</h1>
				<a href="/blog/">View all</a>
			</div>
			<ol class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<span class="post-content">
								<strong>{post.data.title}</strong>
								<span>{post.data.description}</span>
								<time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
							</span>
						</a>
					</li>
				))}
			</ol>
		</section>
	</main>
	<Footer />
</body>
</html>
<style>
section { max-width: 800px; }
.section-heading {
	display: flex;
	align-items: baseline;
	justify-content: space-between;
	gap: 1rem;
	margin-bottom: .5rem;
}
.section-heading h1 {
	font-size: 1.15rem;
	font-family: var(--sans);
	font-weight: 700;
	letter-spacing: .08em;
	text-transform: uppercase;
}
.section-heading a { font-size: .85rem; text-decoration: none; }
.post-list {
	margin: 0;
	padding: 0;
	list-style: none;
	border-top: 1px solid var(--rule);
}
.post-list li { border-bottom: 1px solid var(--rule); }
.post-list a {
	display: block;
	padding: 1rem 0;
	color: inherit;
	text-decoration: none;
}
.post-content { display: grid; gap: .3rem; }
.post-content strong {
	color: var(--text);
	font-family: var(--serif);
	font-size: clamp(1.35rem, 2.5vw, 1.8rem);
	line-height: 1.15;
}
.post-content span { max-width: 680px; color: var(--muted); }
time {
	color: var(--muted);
	font-size: .78rem;
	letter-spacing: .04em;
	text-transform: uppercase;
}
.post-list a:hover strong {
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-underline-offset: .12em;
}
</style>
