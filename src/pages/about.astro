---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StructuredData from '../components/StructuredData.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---
<!doctype html>
<html lang="en">
<head>
	<BaseHead title={`About · ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	<StructuredData type="profile" title="About Hanif Azrai" description={SITE_DESCRIPTION} url={Astro.url} />
</head>
<body>
	<Header />
	<main>
		<article class="about">
			<p class="eyebrow">About</p>
			<h1>I'm Hanif.</h1>
			<p class="lead">I work with content, SEO and technology. I enjoy figuring out how things work, building useful things, and writing about what I discover.</p>
			<h2>What I'm interested in</h2>
			<p>Technology, the web, SEO, consumer products, science, motorcycles, DIY projects, and the occasional rabbit hole that starts with a simple question.</p>
			<h2>Elsewhere</h2>
			<p><a href="https://github.com/inibukunota" rel="me">GitHub</a></p>
		</article>
	</main>
	<Footer />
</body>
</html>
<style>
.about { max-width: var(--reading-width); }
.eyebrow { color: rgb(var(--gray)); }
.lead { font-size: 1.3rem; margin: 1.5rem 0 4rem; }
.about h2 { margin-top: 3rem; font-size: 1.5rem; }
</style>
