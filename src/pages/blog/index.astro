---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import StructuredData from '../../components/StructuredData.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const items = posts.map((post) => ({
	title: post.data.title,
	url: new URL(`/blog/${post.id}/`, Astro.site).toString(),
	description: post.data.description,
}));
const pageTitle = `Blog · ${SITE_TITLE}`;
const pageDescription = 'Articles and notes from a personal laboratory about technology, the web, SEO, experiments and things worth figuring out.';
---
<!doctype html>
<html lang="en">
<head>
	<BaseHead title={pageTitle} description={pageDescription} />
	<StructuredData type="collection" title="Blog" description={pageDescription} url={Astro.url} items={items} />
</head>
<body>
	<Header />
	<main>
		<header class="page-header">
			<h1>Blog</h1>
			<p>{pageDescription}</p>
		</header>
		<section aria-label="All blog posts">
			<ol class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<span class="post-content">
								<strong>{post.data.title}</strong>
								<span>{post.data.description}</span>
								<time datetime={post.data.pubDate.toISOString()}><FormattedDate date={post.data.pubDate} /></time>
							</span>
						</a>
					</li>
				))}
			</ol>
		</section>
	</main>
	<Footer />
</body>
</html>
<style>
.page-header { max-width: var(--reading-width); margin-bottom: 1rem; }
.page-header h1 { margin-bottom: .75rem; }
.page-header > p { color: var(--muted); }
.post-list {
	margin: 0;
	padding: 0;
	list-style: none;
	border-top: 1px solid var(--rule);
}
.post-list li { border-bottom: 1px solid var(--rule); }
.post-list a {
	display: block;
	padding: 1rem 0;
	color: inherit;
	text-decoration: none;
}
.post-content { display: grid; gap: .3rem; }
.post-content strong {
	color: var(--text);
	font-family: var(--serif);
	font-size: clamp(1.3rem, 2.5vw, 1.8rem);
	line-height: 1.15;
}
.post-content span { color: var(--muted); }
time {
	color: var(--muted);
	font-size: .78rem;
	letter-spacing: .04em;
	text-transform: uppercase;
}
.post-list a:hover strong {
	text-decoration: underline;
	text-decoration-thickness: 1px;
	text-underline-offset: .12em;
}
</style>
